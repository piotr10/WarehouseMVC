@using Microsoft.AspNetCore.Components.Web
@using System.Net;
@using Microsoft.AspNetCore.Hosting
@using WarehouseMVC.Domain.Model
@using WarehouseMVC.Web.Controllers
@model WarehouseMVC.Application.ViewModel.Image.NewImageModelVm


@{
    ViewData["Title"] = "Edit";
}

<h1 align="center">Edit</h1>
<hr />
<form asp-action="Edit" id="form1" runat="server" enctype="multipart/form-data">
    <div align="center" style="width:25%; height:auto; margin-left:175px; float:left;">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IsHired" />
        <input type="hidden" asp-for="AddFrom" />
        <div class="form-group">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Surname" class="control-label"></label>
            <input asp-for="Surname" class="form-control" />
            <span asp-validation-for="Surname" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Address" class="control-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Email" class="control-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Phone" class="control-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="EmployedUnder" class="control-label"></label>
            <select asp-for="EmployedUnder" class="form-control" asp-items="Html.GetEnumSelectList<EmployedUnder>()"></select>
            <span asp-validation-for="EmployedUnder" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="GroupManagerId" class="control-label"></label>
            <select asp-for="GroupManagerId" class="form-control" asp-items="@ViewBag.GroupManagerId"></select>
            <span asp-validation-for="GroupManagerId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="GroupLeaderId" class="control-label"></label>
            <select asp-for="GroupLeaderId" class="form-control" asp-items="@ViewBag.GroupLeaderId"></select>
            <span asp-validation-for="GroupLeaderId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="CompanyId" class="control-label"></label>
            <select asp-for="CompanyId" class="form-control" asp-items="@ViewBag.CompanyId"></select>
            <span asp-validation-for="CompanyId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Price" class="control-label">Price BRUTTO</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
    </div>

    <div align="center" style="width:25%; height:auto; margin-right:175px; float:right;">
        <div class="form-group">
            <label asp-for="AcceptHiredRecruitment" class="control-label" style="color: peru;"></label>
            <select asp-for="AcceptHiredRecruitment" class="form-control" asp-items="Html.GetEnumSelectList<AcceptHiredRecruitment>()"></select>
            <span asp-validation-for="AcceptHiredRecruitment" class="text-danger"></span>
        </div>
        <div class="form-group">
            <input asp-for="AcceptDateTimeRecruitment" class="form-control" />
            <span asp-validation-for="AcceptDateTimeRecruitment" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="AcceptHiredControlling" class="control-label" style="color: peru;"></label>
            <select asp-for="AcceptHiredControlling" class="form-control" asp-items="Html.GetEnumSelectList<AcceptHiredControlling>()"></select>
            <span asp-validation-for="AcceptHiredControlling" class="text-danger"></span>
        </div>
        <div class="form-group">
            <input asp-for="AcceptDateTimeControlling" class="form-control" />
            <span asp-validation-for="AcceptDateTimeControlling" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="AcceptHiredCfo" class="control-label" style="color: peru;"></label>
            <select asp-for="AcceptHiredCfo" class="form-control" asp-items="Html.GetEnumSelectList<AcceptHiredCfo>()"></select>
            <span asp-validation-for="AcceptHiredCfo" class="text-danger"></span>
        </div>
        <div class="form-group">
            <input asp-for="AcceptDateTimeCfo" class="form-control" />
            <span asp-validation-for="AcceptDateTimeCfo" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="EmploymentDate" class="control-label"></label>
            <input asp-for="EmploymentDate" class="form-control" />
            <span asp-validation-for="EmploymentDate" class="text-danger"></span>
        </div>
        <div class="form-group disabled">
            <label asp-for="Status" class="control-label"></label>
            <input asp-for="Status" class="form-control" />
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="ImageName" class="control-label"></label>
            <input asp-for="ImageName" class="form-control" />
            <span asp-validation-for="ImageName" class="text-danger"></span>
            <a asp-action="GetBlobDownload" asp-route-id="@Model.Id">Download</a>
        </div>
        <div class="form-group">
            <label asp-for="ImageFile" class="control-label"></label>
            <input asp-for="ImageFile" type="file" name="attachments" multiple="multiple" accept="*/*" align="middle" />
            <span asp-validation-for="ImageFile" class="text-danger"></span>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Payroll"))
        {
            <a asp-controller="Questionnaire" asp-action="Send" asp-route-id="@Model.Id">Send Questionnaire</a>
            <br />
            <a asp-controller="Questionnaire" asp-action="Edit" asp-route-id="@Model.Id">Edit Questionnaire</a>
            <br />
            <a asp-controller="Questionnaire" asp-action="Index">View all Questionnaires</a>
        }
    </div>

    <div style="clear:both"></div>

    <div align="center" style="margin-top:40px; margin-bottom:20px;">
        <table width="30%" style="margin: auto; text-align: left;">
            <tr><h5 align="center">Select the type of application you are submitting:</h5></tr>
            <br />
            <tr align="center">
                <th>Establishment plan</th>
                <th>Add hoc</th>
                <th>Employee rotations</th>
            </tr>
            <tr align="center">
                <th><input asp-for="CompatibleHarmonogram" type="checkbox" class="form-control"></th>
                <th><input asp-for="AddHoc" type="checkbox" class="form-control"></th>
                <th><input asp-for="Rotation" type="checkbox" class="form-control"></th>
            </tr>
        </table>
        <br />
        @if (User.IsInRole("Admin") || User.IsInRole("Payroll"))
        {
            <div align="center">
                <table width="20%" style="margin: auto; text-align: left;">
                    <h5 align="center">Do you want to hire a new employee?</h5>
                    <tr>
                        <th>
                            <h6 align="center">YES</h6>
                            <input asp-for="FinallyHiredPayroll" type="checkbox" class="form-control">
                        </th>
                        <th>
                            <h6 align="center">NO</h6>
                            <input asp-for="FinallyHiredPayrollFalse" type="checkbox" class="form-control"
                                   onchange="document.getElementById('ReasonDenied').disabled = !this.checked;"/>
                        </th>
                    </tr>
                </table>
                <br/>
                <h6>Please enter the reason of resignation</h6>
                <input class="form-control" style="text-align: center; width: 30%; margin: auto;" asp-for="ReasonDenied" disabled="disabled"/>
            </div>
        }
        <div class="alert-success">
            @TempData["checkvaltrue"]
        </div>
        <div class="alert-danger">
            @TempData["checkvalfalse"]
        </div>
        <div class="alert-success">
            @TempData["applyvaltrue"]
        </div>
        <div class="alert-danger">
            @TempData["applyvalfalse"]
        </div><br />
        <div class="form-group">
            <input type="submit" value="Save" class="btn btn-primary" />
        </div>
        <div>
            <a asp-action="Index">Back to List</a>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}